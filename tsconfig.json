{
  "extends": "expo/tsconfig.base",

  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },

    /* optional but speeds up IDE */
    "skipLibCheck": true,
    "noImplicitReturns": true
  },

  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
